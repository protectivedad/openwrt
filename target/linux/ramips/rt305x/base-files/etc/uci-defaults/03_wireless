. /lib/functions/uci-defaults.sh

board=$(board_name)

case $board in
dlink,dsp-w115)
	# already configured don't touch
	uci -q get wireless.sta_radio0 >/dev/null && exit 0

	# wireless only device so do NOT disable
	uci set wireless.@wifi-device[0].channel='auto'
	uci set wireless.@wifi-device[0].disabled='0'
	uci set wireless.@wifi-iface[0].disabled='0'

	eval "$(strings /dev/mtd1 | grep -E '^ApCli')"
	uci set wireless.sta_radio0=wifi-iface
	uci set wireless.sta_radio0.device='radio0'
	uci set wireless.sta_radio0.network='wwan'
	uci set wireless.sta_radio0.mode='sta'
	[ "WPA2PSK" = "${ApCliAuthMode:-WPA2PSK}" ] && uci set wireless.sta_radio0.encryption='psk2'
	uci set wireless.sta_radio0.ssid="${ApCliSsid:-unknown}"
	uci set wireless.sta_radio0.key="${ApCliWPAPSK:-unknown}"
	[ "0" = "${ApCliEnable}" ] && uci set wireless.sta_radio0.disabled='1'

	uci commit wireless
	;;
esac

exit 0
